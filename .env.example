# ---------------- Server ----------------
PORT=3000
NODE_ENV=production

# ---------------- Database ----------------
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_PORT=5432
DB_HOST=db
DB_NAME=car_application
TEST_DB_NAME=car_application_test

# ---------------- Auth ----------------
JWT_SECRET=replace_with_a_long_random_secret_key

# ---------------- Frontend ----------------
FRONTEND_URL=http://your-domain-or-ip
NG_PORT=4200

# ---------------- n8n Automation ----------------
N8N_WEBHOOK_URL=http://n8n:5678/webhook/chatbot
N8N_BOOKING_WEBHOOK_URL=http://n8n:5678/webhook/booking-notify
N8N_USER=admin
N8N_PASSWORD=replace_with_a_strong_password

# ---------------- Google Gemini API ----------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------- WhatsApp Business API (optional — dummy mode works without these) ----------------
# WHATSAPP_PHONE_NUMBER_ID=your_number_id
# WHATSAPP_TOKEN=your_permanent_token